I common.mc
L softstack.ld
L mul.ld
L string.ld
I basic_storage.asm
I basic_support.asm
# basic/v0/basic_main.asm
# BASIC v0 – Editor Shell (ESX716 compliant)
#
# Responsibilities:
#   - Prompt
#   - Read full line via READSI
#   - Distinguish program lines vs commands
#   - Dispatch to storage layer
#
# No tokenizer, no execution yet.

# --------------------------------------------------
# Input buffer (READSI requires full 256 bytes)
# --------------------------------------------------

=INPUTBUF_SIZE 256

:InputBuf
.ORG InputBuf+INPUTBUF_SIZE


# --------------------------------------------------
# BASIC entry point
# --------------------------------------------------

:BasicMain
    @CALL InitProgramStorage

:MainLoop
    @PRT "> "

    # Read a full line (device handles editing & termination)
    @READS InputBuf

    # If empty line, reprompt
    @LOADBI InputBuf
    @IF_ZERO
        @JMP MainLoop
    @ENDIF

    @Call(A) ParseLineOrCommand InputBuf

    @JMP MainLoop


# --------------------------------------------------
# ParseLineOrCommand
# --------------------------------------------------
# IN:
#   TOS = pointer to input buffer
# --------------------------------------------------

:ParseLineOrCommand
@PUSHRETURN
    @LocalVar BufPtr 01
    @LocalVar Ch     02

    @POPI BufPtr

    @Call(v) ISNumeric BufPtr
    @IF_NOTZERO
        @CALL ParseLineNumber
        @CALL InsertOrDeleteLine
        @RestoreVar 02
        @RestoreVar 01
        @RET
    @ENDIF

    @CALL ParseCommand

    @RestoreVar 02
    @RestoreVar 01
@POPRETURN
@RET


# --------------------------------------------------
# ParseLineNumber
# --------------------------------------------------
# IN:
#   BufPtr
# OUT (stack):
#   LineNum
#   TextPtr
#   TextLen
# --------------------------------------------------

:ParseLineNumber
    @LocalVar Acc     01
    @LocalVar Ptr     02
    @LocalVar Ch      03
    @LocalVar TextPtr 04
    @LocalVar TextLen 05

    @MA2V 0 Acc

    @MV2V BufPtr Ptr

    # Parse decimal line number
    @PUSH 0
    @WHILE_ZERO

        @Call(v) ISNumeric Ptr
        @IF_ZERO
           @POPNULL
	   @PUSH 1         # Break While Loop
        @ELSE
           @LOADI Acc
           @PUSHI 10
           @CALL MULU
           @PUSHI Ch
           @SUB "0\0"   # pads to little end 16 bit number
           @ADDS
           @STOREI Acc
           @INCI Ptr
	@ENDIF
    @ENDWHILE
    @POPNULL

    # Skip spaces after line number
    @PUSH 0
    @WHILE_ZERO
        @LOADBII Ptr
        @POPI Ch
        @IF_NEQ_A ' '
            @WHILEBREAK
        @ENDIF
        @INCI Ptr
    @ENDWHILE
    @POPNULL

    # Remaining text pointer
    @MV2V Ptr TextPtr

    # Compute text length
    @PUSHI 0
    @STOREI TextLen

    @PUSH 0
    @WHILE_ZERO
        @LOADBII Ptr
        @IF_ZERO
            @WHILEBREAK
        @ENDIF
        @INCI Ptr
        @INCI TextLen
    @ENDWHILE
    @POPNULL

    # Return values on stack (order matters!)
    @LOADI Acc
    @PUSHI TextPtr
    @LOADI TextLen

    @RestoreVar 05
    @RestoreVar 04
    @RestoreVar 03
    @RestoreVar 02
    @RestoreVar 01
@RET


# --------------------------------------------------
# ParseCommand
# --------------------------------------------------
# Simple v0 command dispatch
# --------------------------------------------------

:ParseCommand
    @STRSTACK "LIST\0"    @PUSH InputBuf     @PUSH 4
    @CALL strncmp
    
    @IF_ZERO
        @POPNULL
        @CALL ListProgram
        @RET
    @ELSE
        @POPNULL
    @ENDIF

    @STRSTACK "NEW\0"    @PUSH InputBuf     @PUSH 3
    @CALL strncmp
    @IF_ZERO
        @POPNULL
        @CALL InitProgramStorage
        @RET
    @ELSE
        @POPNULL
    @ENDIF


    @STRSTACK "RUN\0"    @PUSH InputBuf     @PUSH 3
    @CALL strncmp
    @IF_ZERO
        @POPNULL
        @CALL RunStub
        @RET
    @ELSE
        @POPNULL
    @ENDIF

    @PRTLN "?SYNTAX ERROR"
@RET

# End of Code, start of data
:ENDOFCODE
=PROGRAM_MEMORY_START ENDOFCODE

# --------------------------------------------------
# Program entry point
# --------------------------------------------------
. BasicMain


