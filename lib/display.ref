# display.ref - public notes for display.ld
#
# Core setup:
#   DisplayInit(HeapID):(RootForm)
#   DisplayFormNew(Parent,RelX,RelY,Width,Height,Flags):(FormPtr)
#   DisplayFieldNew(Form,Type,RelX,RelY,Width,Height,ValuePtr,Format,Flags):(FieldPtr)
#   DisplayUpdate()
#
# Use FORM_FLAG_VISIBLE|FORM_FLAG_ENABLED for normal forms.
# Use FIELD_FLAG_VISIBLE for normal fields.
# Initial field types: INTEGER, LONG, STRING, TEXT, BOX, CHARACTER.
